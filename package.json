{
  "name": "dsh-desk-pet-plugin",
  "version": "2.0.0",
  "description": "Floating desk pet for DeepSeek Harness: a screen-level animated pet that mirrors live session status, jumps to the session on click, and installs pets from petdex.dev.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "dist/index.js",
    "dist/client.js",
    "dist/pet-core.js",
    "dist/screen/*",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/pet.jpg",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desk-pet",
    "pet",
    "桌宠",
    "overlay",
    "always-on-top"
  ],
  "author": "ZGJ <zg.jun@qq.com>",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zg-jun/dsh-desk-pet-plugin.git"
  },
  "homepage": "https://github.com/zg-jun/dsh-desk-pet-plugin#readme",
  "bugs": "https://github.com/zg-jun/dsh-desk-pet-plugin/issues",
  "scripts": {
    "check": "npm run build && node --check dist/index.js && node --check dist/client.js && node --check scripts/check-live.mjs && node --check scripts/bench.mjs && node --check scripts/visual-check.mjs && node --check scripts/archive/acceptance-probe.mjs && node --check src/scene/screen/renderer.js && node --check dist/screen/main.cjs && node --check dist/screen/host-watchdog.cjs && node --check dist/screen/display.cjs && node --check dist/screen/preload.cjs && tsc --noEmit && npm run typecheck:js && npm run lint && vitest run && node scripts/validate/metrics.mjs src/index.js src/scene/web/client.js src/scene/screen/renderer.js --quiet && node scripts/validate/float-dom.mjs --check && node scripts/check-debt.mjs && npm run check:install",
    "check:dom": "node scripts/validate/float-dom.mjs --check",
    "check:debt": "node scripts/check-debt.mjs",
    "check:live": "node scripts/check-live.mjs",
    "bench": "npm run build && node scripts/bench.mjs",
    "baseline": "node scripts/validate/float-dom.mjs",
    "dev:install": "node scripts/dev-install.mjs --profile desktop",
    "dev:install:apply": "node scripts/dev-install.mjs --profile desktop --apply",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "e2e": "npm run build && node scripts/validate/e2e-host.mjs",
    "typecheck:js": "tsc -p tsconfig.checkjs.json --noEmit",
    "acceptance:probe": "node scripts/archive/acceptance-probe.mjs",
    "lint": "eslint src scripts",
    "check:phase2": "node scripts/validate/phase2-live.mjs",
    "check:install": "node scripts/validate/install-e2e.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.17.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "jsdom": "^24.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "main": "./index.js"
}
